

#ifndef RCC_HPP_
#define RCC_HPP_

#include "types.hpp"
#include "STM32F4/stm32f446xx.h"

namespace RCC_AHB1ENR {
	constexpr u32 GPIOA = (1U << 0);
	constexpr u32 GPIOB = (1U << 1);
	constexpr u32 GPIOC = (1U << 2);
	constexpr u32 GPIOD = (1U << 3);
	constexpr u32 GPIOE = (1U << 4);
	constexpr u32 GPIOF = (1U << 5);
	constexpr u32 GPIOG = (1U << 6);
	constexpr u32 GPIOH = (1U << 7);
}

class Rcc {
public:

	void resetAhb1(){
		RCC->AHB1ENR  = 0x0;
	}

	void enableAhb1(u32 mask){
		RCC->AHB1ENR |= mask;
	}

	void enableApb2(u32 mask){
			RCC->APB2ENR |= mask;
	}
};

#endif /* RCC_HPP_ */
