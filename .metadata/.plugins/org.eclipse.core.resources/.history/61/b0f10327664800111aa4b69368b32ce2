

#ifndef RCC_HPP_
#define RCC_HPP_

#include "types.hpp"
#include "STM32F4/stm32f446xx.h"

enum class Ahb1Enr : u32 {
	GPIOA = 0x0, // bit 0
	GPIOB = 0x1, // bit 1
	GPIOC = 0x2, // bit 2
	GPIOD = 0x8, // bit 3
	GPIOE = 0x10, // bit 4
	GPIOF = 0x40, //bit 5
	GPIOG = 0x84, // bit 6
	GPIOH = 0x100, // bit 7
};

class Rcc {
public:

	void resetAhb1(){
		RCC->AHB1ENR  = 0x0;
	}

	void enableAhb1(u32 mask){
		RCC->AHB1ENR |= mask;
	}

	void enableApb2(u32 mask){
			RCC->APB2ENR |= mask;
	}
};

#endif /* RCC_HPP_ */
