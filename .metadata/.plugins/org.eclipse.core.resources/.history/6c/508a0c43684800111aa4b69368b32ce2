

#ifndef RCC_HPP_
#define RCC_HPP_

#include "types.hpp"
#include "STM32F4/stm32f446xx.h"

namespace RCC_AHB1ENR {
	constexpr GPIOA = (1U << 0);
}

class Rcc {
public:

	void resetAhb1(){
		RCC->AHB1ENR  = 0x0;
	}

	void enableAhb1(u32 mask){
		RCC->AHB1ENR |= mask;
	}

	void enableApb2(u32 mask){
			RCC->APB2ENR |= mask;
	}
};

#endif /* RCC_HPP_ */
