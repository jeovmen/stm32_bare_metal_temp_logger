#include "types.hpp"
#include "STM32F4/stm32f446xx.h"

enum class Mode : uint8 {
	Input = 0b00,
	Output = 0b01,
	Alt = 0b10,
	Analog = 0b11
};

enum class Speed : uint8 {
	Low = 0b00,
	Medium = 0b01,
	High = 0b10,
	Fast = 0b11
};

enum class Pull : uint8 {
	None = 0b00,
	Up = 0b01,
	Down = 0b10
};

enum class AF : uint8 {
    AF0 = 0x0 , AF1 = 0x1, AF2 = 0x2, AF3 = 0x3,
    AF4 = 0x4 , AF5 = 0x5 , AF6 = 0x6, AF7 = 0x7,
    AF8 = 0x8, AF9 = 0x9, AF10 = 0xA, AF11 = 0xB,
    AF12 = 0xC, AF13 = 0xD, AF14 = 0xE, AF15 = 0xF
};

class Gpio {
public:
	explicit Gpio(GPIO_TypeDef* port)
		: port(port) {}

	void setMode(uint8 pin, Mode mode){
		uint32 shift = pin * 2;
		uint32 mask = 0x3 << shift;

		port->MODER = (port->MODER & ~mask) | (static_cast<uint32>(mode) << shift);
	}

	void setPull(uint8 pin, Pull pull){
		uint32 shift = pin * 2;
		uint32 mask = 0x3 << shift;

		port->PUPDR = (port->PUPDR & ~mask) | (static_cast<uint32>(pull) << shift);
	}

	void setSpeed(uint8 pin, Speed speed)
	{
		uint32 shift = pin * 2;
		uint32 mask = 0x3 << shift;

		port->OSPEEDR = (port->OSPEEDR & ~mask) | (static_cast<uint32>(speed) << shift);
	}

