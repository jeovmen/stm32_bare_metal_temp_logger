

#ifndef RCC_HPP_
#define RCC_HPP_

#include "types.hpp"
#include "STM32F4/stm32f446xx.h"

enum class RCC_AHB1ENR {
	GPIOA = (1U << 0), GPIOB = (1U << 1), GPIOC = (1U << 2),
	GPIOD = (1U << 3), GPIOE = (1U << 4), GPIOF = (1U << 5),
	GPIOG = (1U << 6), GPIOH = (1U << 7)
};

class Rcc {
public:

	void resetAhb1(){
		RCC->AHB1ENR  = 0x0;
	}

	void enableAhb1(RCC_AHB1ENR mask ){
		RCC->AHB1ENR |= mask;
	}

	void enableApb2(u32 mask){
			RCC->APB2ENR |= mask;
	}
};

#endif /* RCC_HPP_ */
