#ifndef RCC_HPP_
#define RCC_HPP_

#include <cstdint>
#include "STM32F4/stm32f446x.h"
using std::uint32_t;

constexpr uint32_t GPIOAEN = (1U<<0);

struct RccRegisters {
    volatile std::uint32_t AHB1ENR;
    volatile std::uint32_t APB2ENR;
};

class Rcc {
public:
	explicit Rcc(RccRegisters* regs) : regs_(regs) {}

	void enableAhb1(uint32_t mask){
		regs_->AHB1ENR |= mask;
	}

	void enableApb2(uint32_t mask){
			regs_->APB2ENR |= mask;
	}

private:
RccRegisters* regs_;
};

RCC->AHB1ENR = 0;
#endif /* RCC_HPP_ */
